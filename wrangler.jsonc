{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fpl-edge",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fpl-edge-db",
      "database_id": "85403b78-6191-4b7b-b61d-c42cd4a02d94",
      "migrations_dir": "./drizzle"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Workers Paid: the autonomous bot runs the optimiser inside the hourly cron (docs/FPL-BOT.md).
  "limits": {
    "cpu_ms": 120000
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
